{
  "name": "@sematico/shopify-flash",
  "description": "Shared React + Inertia v3 client for Shopify App Bridge toast and Polaris s-banner UX, paired with sematico/laravel-shopify-flash on the backend.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Alessandro Tesoro <alessandro@levelogy.com>",
  "homepage": "https://github.com/alessandrotesoro/laravel-shopify-flash",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alessandrotesoro/laravel-shopify-flash.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "js",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check js",
    "lint:fix": "biome check --write js",
    "format": "biome format --write js",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@inertiajs/react": "^3.0.0",
    "@shopify/app-bridge-react": "^4.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@inertiajs/react": "^3.0.0",
    "@shopify/app-bridge-react": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
